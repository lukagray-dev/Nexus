<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/app_lock_setup_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    android:padding="20dp">

    <!-- Top Navigation Header -->
    <LinearLayout
        android:id="@+id/setup_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_container"
            android:contentDescription="@string/btn_backspace"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_left"
            app:tint="@color/text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_setup_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/app_lock_setup_title"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_setup_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:text="@string/app_lock_status_disabled"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_app_lock_enable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Setup Prompt Section -->
    <LinearLayout
        android:id="@+id/prompt_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/setup_header">

        <TextView
            android:id="@+id/text_step_prompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:text="@string/app_lock_setup_step1"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_step_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="Choose a secure 6-digit PIN code"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- 6 PIN Dots Indicator -->
        <LinearLayout
            android:id="@+id/setup_pin_dots_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/setup_dot_1"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginHorizontal="8dp"
                android:contentDescription="@string/pin_digit_1"
                android:src="@drawable/pin_dot_empty" />

            <ImageView
                android:id="@+id/setup_dot_2"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginHorizontal="8dp"
                android:contentDescription="@string/pin_digit_2"
                android:src="@drawable/pin_dot_empty" />

            <ImageView
                android:id="@+id/setup_dot_3"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginHorizontal="8dp"
                android:contentDescription="@string/pin_digit_3"
                android:src="@drawable/pin_dot_empty" />

            <ImageView
                android:id="@+id/setup_dot_4"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginHorizontal="8dp"
                android:contentDescription="@string/pin_digit_4"
                android:src="@drawable/pin_dot_empty" />

            <ImageView
                android:id="@+id/setup_dot_5"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginHorizontal="8dp"
                android:contentDescription="@string/pin_digit_5"
                android:src="@drawable/pin_dot_empty" />

            <ImageView
                android:id="@+id/setup_dot_6"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginHorizontal="8dp"
                android:contentDescription="@string/pin_digit_6"
                android:src="@drawable/pin_dot_empty" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_setup_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:textColor="@color/status_error"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="PINs do not match. Please re-enter"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Keypad Grid -->
    <GridLayout
        android:id="@+id/setup_keypad_grid"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:alignmentMode="alignMargins"
        android:columnCount="3"
        android:rowCount="4"
        android:useDefaultMargins="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/setup_btn_1"
            style="@style/NexusKeypadButton"
            android:text="1" />

        <TextView
            android:id="@+id/setup_btn_2"
            style="@style/NexusKeypadButton"
            android:text="2" />

        <TextView
            android:id="@+id/setup_btn_3"
            style="@style/NexusKeypadButton"
            android:text="3" />

        <TextView
            android:id="@+id/setup_btn_4"
            style="@style/NexusKeypadButton"
            android:text="4" />

        <TextView
            android:id="@+id/setup_btn_5"
            style="@style/NexusKeypadButton"
            android:text="5" />

        <TextView
            android:id="@+id/setup_btn_6"
            style="@style/NexusKeypadButton"
            android:text="6" />

        <TextView
            android:id="@+id/setup_btn_7"
            style="@style/NexusKeypadButton"
            android:text="7" />

        <TextView
            android:id="@+id/setup_btn_8"
            style="@style/NexusKeypadButton"
            android:text="8" />

        <TextView
            android:id="@+id/setup_btn_9"
            style="@style/NexusKeypadButton"
            android:text="9" />

        <TextView
            android:id="@+id/setup_btn_clear"
            style="@style/NexusKeypadButtonAction"
            android:text="C" />

        <TextView
            android:id="@+id/setup_btn_0"
            style="@style/NexusKeypadButton"
            android:text="0" />

        <FrameLayout
            android:id="@+id/setup_btn_backspace"
            style="@style/NexusKeypadButtonAction">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/btn_backspace"
                android:src="@drawable/ic_arrow_left"
                app:tint="@color/text_primary" />
        </FrameLayout>
    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
