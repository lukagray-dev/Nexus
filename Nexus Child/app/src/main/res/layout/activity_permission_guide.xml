<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    android:padding="20dp">

    <!-- ========================================================================= -->
    <!-- TOP NAVIGATION: Back Button & Tactical Step Indicator Pill                -->
    <!-- ========================================================================= -->
    <LinearLayout
        android:id="@+id/guide_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_guide_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_button_secondary"
            android:contentDescription="@string/guide_return_home"
            android:padding="9dp"
            android:src="@drawable/ic_arrow_left"
            app:tint="@color/text_primary" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/text_step_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_tactical"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:text="STEP 1 OF 6"
            android:textAllCaps="true"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ========================================================================= -->
    <!-- CENTER MAIN CARD: Permission Icon, Category Pill, Title, Description      -->
    <!-- ========================================================================= -->
    <LinearLayout
        android:id="@+id/card_guide_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_tactical"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="32dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp"
        app:layout_constraintBottom_toTopOf="@id/guide_button_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/guide_top_bar"
        app:layout_constraintVertical_bias="0.45">

        <!-- Icon Container -->
        <FrameLayout
            android:id="@+id/frame_icon_container"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:background="@drawable/bg_icon_container">

            <ImageView
                android:id="@+id/image_permission_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:contentDescription="@string/permissions_card_title"
                android:src="@drawable/ic_battery"
                app:tint="@color/text_primary" />
        </FrameLayout>

        <!-- Category Tag -->
        <TextView
            android:id="@+id/text_permission_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_pill_tactical"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="SYSTEM CAPABILITY"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <!-- Permission Title -->
        <TextView
            android:id="@+id/text_permission_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/perm_battery_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Detailed Rationale / Description -->
        <TextView
            android:id="@+id/text_permission_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/perm_battery_desc"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Live Status Pill inside Card -->
        <LinearLayout
            android:id="@+id/guide_status_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_pill_tactical"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp">

            <View
                android:id="@+id/guide_status_led"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/status_led_inactive" />

            <TextView
                android:id="@+id/guide_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="PENDING AUTHORIZATION"
                android:textAllCaps="true"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ========================================================================= -->
    <!-- BOTTOM BUTTON BAR: Action Button (Open/Grant) & Skip Option               -->
    <!-- ========================================================================= -->
    <LinearLayout
        android:id="@+id/guide_button_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_grant_action"
            style="@style/Widget.Nexus.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/guide_open_settings"
            android:textSize="15sp"
            app:icon="@drawable/ic_chevron_right"
            app:iconGravity="textEnd" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_skip_action"
            style="@style/Widget.Nexus.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="@string/guide_skip"
            android:textSize="14sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
