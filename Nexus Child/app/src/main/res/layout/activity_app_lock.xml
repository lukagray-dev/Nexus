<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/app_lock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    android:padding="24dp">

    <!-- Top Lock Header -->
    <LinearLayout
        android:id="@+id/lock_header_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/pin_dots_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">

        <ImageView
            android:id="@+id/icon_lock"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_icon_container"
            android:contentDescription="@string/app_lock_locked_title"
            android:padding="14dp"
            android:src="@drawable/ic_sidebar_lock"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/text_lock_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05"
            android:text="@string/app_lock_locked_title"
            android:textAllCaps="true"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_lock_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:text="@string/app_lock_enter_pin"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/text_lockout_warning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textColor="@color/status_error"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Too many failed attempts. Try again in 59s"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- 6 PIN Dots Indicator -->
    <LinearLayout
        android:id="@+id/pin_dots_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="36dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/keypad_grid"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lock_header_container">

        <ImageView
            android:id="@+id/dot_1"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="8dp"
            android:contentDescription="@string/pin_digit_1"
            android:src="@drawable/pin_dot_empty" />

        <ImageView
            android:id="@+id/dot_2"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="8dp"
            android:contentDescription="@string/pin_digit_2"
            android:src="@drawable/pin_dot_empty" />

        <ImageView
            android:id="@+id/dot_3"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="8dp"
            android:contentDescription="@string/pin_digit_3"
            android:src="@drawable/pin_dot_empty" />

        <ImageView
            android:id="@+id/dot_4"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="8dp"
            android:contentDescription="@string/pin_digit_4"
            android:src="@drawable/pin_dot_empty" />

        <ImageView
            android:id="@+id/dot_5"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="8dp"
            android:contentDescription="@string/pin_digit_5"
            android:src="@drawable/pin_dot_empty" />

        <ImageView
            android:id="@+id/dot_6"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="8dp"
            android:contentDescription="@string/pin_digit_6"
            android:src="@drawable/pin_dot_empty" />
    </LinearLayout>

    <!-- Numeric Keypad Grid -->
    <GridLayout
        android:id="@+id/keypad_grid"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:alignmentMode="alignMargins"
        android:columnCount="3"
        android:rowCount="4"
        android:useDefaultMargins="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Row 1: 1, 2, 3 -->
        <TextView
            android:id="@+id/btn_key_1"
            style="@style/NexusKeypadButton"
            android:text="1" />

        <TextView
            android:id="@+id/btn_key_2"
            style="@style/NexusKeypadButton"
            android:text="2" />

        <TextView
            android:id="@+id/btn_key_3"
            style="@style/NexusKeypadButton"
            android:text="3" />

        <!-- Row 2: 4, 5, 6 -->
        <TextView
            android:id="@+id/btn_key_4"
            style="@style/NexusKeypadButton"
            android:text="4" />

        <TextView
            android:id="@+id/btn_key_5"
            style="@style/NexusKeypadButton"
            android:text="5" />

        <TextView
            android:id="@+id/btn_key_6"
            style="@style/NexusKeypadButton"
            android:text="6" />

        <!-- Row 3: 7, 8, 9 -->
        <TextView
            android:id="@+id/btn_key_7"
            style="@style/NexusKeypadButton"
            android:text="7" />

        <TextView
            android:id="@+id/btn_key_8"
            style="@style/NexusKeypadButton"
            android:text="8" />

        <TextView
            android:id="@+id/btn_key_9"
            style="@style/NexusKeypadButton"
            android:text="9" />

        <!-- Row 4: Clear, 0, Backspace -->
        <TextView
            android:id="@+id/btn_key_clear"
            style="@style/NexusKeypadButtonAction"
            android:text="C" />

        <TextView
            android:id="@+id/btn_key_0"
            style="@style/NexusKeypadButton"
            android:text="0" />

        <FrameLayout
            android:id="@+id/btn_key_backspace"
            style="@style/NexusKeypadButtonAction">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/btn_backspace"
                android:src="@drawable/ic_arrow_left"
                app:tint="@color/text_primary" />
        </FrameLayout>

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
