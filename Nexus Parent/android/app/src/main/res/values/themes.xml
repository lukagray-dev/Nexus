<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Pitch-black tactical window theme to prevent white flash during cold start -->
    <style name="Theme.NexusParent" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/canvas_black</item>
        <item name="android:colorBackground">@color/canvas_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/canvas_black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
